{
  "name": "@javibarrientos17/all-in-one-toolbox",
  "version": "1.0.0",
  "type": "module",
  "description": "All-in-One Toolbox - A comprehensive desktop application for Windows with multiple utilities",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaviBarrientos17/all-in-one-toolbox.git"
  },
  "author": "JaviBarrientos17",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "npm run build && wrangler dev",
    "report": "node generate-report.js",
    "auto-report": "node auto-report.js",
    "version:patch": "node bump-version.js patch",
    "version:minor": "node bump-version.js minor",
    "version:major": "node bump-version.js major",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.11.0",
    "browser-image-compression": "^2.0.2",
    "file-saver": "^2.0.5",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "upscaler": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "wrangler": "^4.95.0"
  }
}
